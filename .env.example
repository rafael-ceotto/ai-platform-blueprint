# Copy this file to .env and adjust values for your environment.
# Never commit the real .env file.

# --- General ---
APP_NAME="AI Platform Blueprint"
ENVIRONMENT=local
DEBUG=true
LOG_LEVEL=INFO
LOG_JSON=false

# --- API ---
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000"]

# --- LLM runtime (Ollama) ---
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_REQUEST_TIMEOUT_SECONDS=60

# --- Vector store (FAISS) ---
VECTOR_STORE_PATH=./data/vector_store
EMBEDDING_MODEL=nomic-embed-text

# --- RAG pipeline (chunking / retrieval) ---
CHUNK_SIZE=500
CHUNK_OVERLAP=50
SEARCH_TOP_K_DEFAULT=5

# --- Auth / rate limiting ---
# Change before any real deployment. An empty list ([]) fails closed:
# every request to a protected endpoint is rejected.
API_KEYS=["dev-local-key"]
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# --- Document ingestion (file upload) ---
MAX_UPLOAD_SIZE_BYTES=10000000
